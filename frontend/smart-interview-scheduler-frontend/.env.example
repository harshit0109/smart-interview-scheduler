# ---------------------------------------------------------------------------
# Frontend configuration. Copy to `.env.local` and adjust as needed.
# NOTHING secret belongs in a NEXT_PUBLIC_* variable — those are inlined into
# the browser bundle.
# ---------------------------------------------------------------------------

# Same-origin base path for API calls. The browser hits the Next.js server at
# this path; next.config.mjs `rewrites()` proxies it to the FastAPI backend, so
# no CORS configuration is required. Leave as-is for local dev.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# FastAPI backend origin that the Next.js rewrite proxy forwards to.
# Server-side only (not exposed to the browser). Defaults to http://localhost:8000.
BACKEND_ORIGIN=http://localhost:8000

# Optional: run the UI with in-memory fixtures and no backend at all.
# Set to "true" to explore the frontend standalone. Real auth/scheduling/booking
# are disabled while this is on.
# NEXT_PUBLIC_DEMO_MODE=false
