# Backend environment variables.
# Copy to `.env` and fill in. Only the Core Infrastructure group is used in Phase 1;
# the rest are declared now (per CODING_GUIDELINES.md) and consumed in later phases.

# ── Core infrastructure (Phase 1) ──
DATABASE_URL=postgresql+asyncpg://sis:sis@localhost:5432/sis
REDIS_URL=redis://localhost:6379/0

# ── Auth / JWT (Phase 2) ──
# JWT_SECRET must be a long random string in any real env. Leave it UNSET (not
# blank) to fall back to the dev-only default in app/core/config.py.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth — IDENTITY LOGIN ONLY (Phase 2). Scopes: openid, email, profile.
#    Never requests Calendar scopes. Separate client config from the Calendar group below. ──
GOOGLE_LOGIN_OAUTH_CLIENT_ID=
GOOGLE_LOGIN_OAUTH_CLIENT_SECRET=
GOOGLE_LOGIN_OAUTH_REDIRECT_URI=

# ── Google OAuth — CALENDAR CONNECTION ONLY (Phase 6). Calendar scopes only.
#    Never requested during login. Separate client config from the login group above. ──
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=

# ── Calendar token encryption at rest (Phase 6) ──
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ── Email confirmation (Phase 8) ──
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=

# ── Frontend ──
FRONTEND_BASE_URL=http://localhost:3000
